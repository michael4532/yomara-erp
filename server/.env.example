APP_NAME="Yomara ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Africa/Abidjan

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=daily
LOG_LEVEL=error

# mysql (MySQL / MariaDB) ou sqlite (aucun serveur de base nécessaire)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Hébergement mutualisé : tout passe par des fichiers ou la base, pas de Redis requis.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Yomara ERP
ERP_MODE=single
ERP_NAME="Yomara ERP"
ERP_CURRENCY=XOF
ERP_COUNTRY=CI
ERP_LICENSE_KEY=
ERP_PRESENCE_WINDOW=120

# Réunions & webinaires : comptes vidéo de la plateforme (facultatif ; chaque société peut saisir les siens)
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=
ZEGO_SERVER=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Synchronisation bancaire (facultatif) : banques européennes via GoCardless Bank Account Data, relevés reçus par e-mail
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
ERP_BANK_INBOUND_DOMAIN=

# Boîte mail : Microsoft 365 (portail Azure › Inscriptions d'applications) et Google Cloud (Identifiants OAuth)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAILBOX_VERIFY_TLS=true

# Adresses fournies par Yomara (module Messagerie hébergée) : jeton API cPanel (cPanel › Sécurité › Gérer les jetons d'API)
MAILBOX_CPANEL_HOST=
MAILBOX_CPANEL_USER=
MAILBOX_CPANEL_TOKEN=
MAILBOX_HOSTED_DOMAIN=
MAILBOX_HOSTED_IMAP_HOST=
MAILBOX_HOSTED_SMTP_HOST=
MAILBOX_HOSTED_QUOTA_MB=2048
MAILBOX_HOSTED_MAX=10
# Anti-spam : plafonds d'envoi (adresses Yomara / serveurs propres)
MAILBOX_HOSTED_PER_HOUR=60
MAILBOX_HOSTED_PER_DAY=300
MAILBOX_OWN_PER_HOUR=200
MAILBOX_OWN_PER_DAY=1500

# Application mobile (liens Play Store / App Store, page /application-mobile)
MOBILE_ANDROID_URL=
MOBILE_IOS_URL=

# Avis Google : clé API Google Maps (Places) pour lire note et derniers avis sans l'API Business Profile
GOOGLE_PLACES_API_KEY=

# Sauvegardes vers Dropbox (facultatif ; Google Drive utilise GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Proxys de confiance (ex. Cloudflare), séparés par des virgules. Vide = aucun : les en-têtes X-Forwarded-* sont ignorés.
TRUSTED_PROXIES=
