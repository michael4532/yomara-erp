<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : allowBackup="false" n'empêche pas le transfert d'appareil à appareil.
     Données de la société (base locale, saisies en attente, jeton) : jamais copiées hors de l'appareil. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
