<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Notifications push (Firebase Cloud Messaging) ; Xcode passe en « production » à l'export App Store -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Groupe partagé avec le widget d'écran d'accueil -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.yomaratechnologies.yomaraerp</string>
	</array>
</dict>
</plist>
